      "source": "def execute(payload, context):\n    a = payload.get(\"a\")\n    b = payload.get(\"b\")\n    if not isinstance(a, int) or not isinstance(b, int):\n        return {\"error\": \"Both 'a' and 'b' must be integers\", \"a\": a, \"b\": b}\n    return {\"result\": a * b, \"operation\": \"multiply\", \"operands\": [a, b]}"
    }
