{
  "name": "@nexgent/test-support",
  "version": "0.0.0",
  "private": true,
  "description": "Test helpers shared by Nexgent packages: scripted model server, fixtures, fault injection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
