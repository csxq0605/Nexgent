{
  "name": "@nexgent/workflow",
  "version": "0.0.0",
  "private": true,
  "description": "workflow 工具：脚本（agent / parallel / pipeline / phase / log）或声明式图在 PTC 运行时里编排工作流成员；图编译器与内容寻址存储。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexgent/kernel": "workspace:*",
    "@nexgent/preset": "workspace:*",
    "@nexgent/ptc": "workspace:*",
    "@nexgent/subagent": "workspace:*"
  },
  "devDependencies": {
    "@nexgent/session": "workspace:*",
    "@nexgent/tasking": "workspace:*",
    "@nexgent/test-support": "workspace:*",
    "@nexgent/workspace": "workspace:*"
  }
}
