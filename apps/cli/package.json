{
  "name": "@nexgent/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Nexgent command-line entry point (nexgent run / resume / export / app)",
  "type": "module",
  "bin": {
    "nexgent": "./bin/nexgent.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexgent/kernel": "workspace:*",
    "@nexgent/llm": "workspace:*",
    "@nexgent/sdk": "workspace:*",
    "@nexgent/workspace": "workspace:*"
  },
  "devDependencies": {
    "@nexgent/evolve": "workspace:*",
    "@nexgent/test-support": "workspace:*"
  }
}
