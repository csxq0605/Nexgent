{
  "name": "@nexgent/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Nexgent 桌面应用（Electron）：主进程持有 SDK，渲染进程经 preload 白名单与访问令牌调用。",
  "type": "module",
  "main": "./dist/main/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build",
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "test": "vitest run",
    "start": "electron .",
    "package:stage": "node scripts/package.mjs stage",
    "package:linux": "node scripts/package.mjs linux",
    "package:win": "node scripts/package.mjs win"
  },
  "dependencies": {
    "@nexgent/kernel": "workspace:*",
    "@nexgent/sdk": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@nexgent/test-support": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "playwright-core": "1.63.0",
    "vite": "8.3.3"
  }
}
